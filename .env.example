# Generate a unique secret locally; see README. Never commit the real .env.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Set a real SMTP backend for deployed password recovery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=hello@adventurenepal.com
SITE_CONTACT_EMAIL=hello@adventurenepal.com
SITE_CONTACT_PHONE=

# Production TLS settings. Trust forwarded HTTPS only on a controlled proxy.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
TRUST_PROXY_HTTPS=False

# Defaults are suitable for a single development process.
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=adventure-nepal
